# ==============================================================================
# AGENTHIVE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and populate your actual API keys and endpoints.
# NEVER commit the real .env file or expose secrets in public channels or logs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SYSTEM & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
ENVIRONMENT=development                     # development | staging | production
LOG_LEVEL=INFO                              # DEBUG | INFO | WARNING | ERROR
AGENTHIVE_HOST=0.0.0.0
AGENTHIVE_PORT=8000
DATABASE_URL=sqlite:///./data/agenthive.db  # Use postgresql+asyncpg://user:pass@host:5432/db for production
WORKSPACE_ROOT=/Users/sidh._./AgentHive/workspaces

# ------------------------------------------------------------------------------
# 2. DISCORD GATEWAY & BOT CONFIGURATION
# ------------------------------------------------------------------------------
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_discord_application_id_here
DISCORD_GUILD_ID=your_discord_server_guild_id_here
DISCORD_LOUNGE_CHANNEL_ID=your_agenthive_lounge_channel_id_here
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ------------------------------------------------------------------------------
# 3. SWITCH COLLABORATION PLATFORM (sandbox-quantum/switch)
# ------------------------------------------------------------------------------
SWITCH_CORE_URL=http://localhost:8080
SWITCH_WS_URL=ws://localhost:8081/events
SWITCH_API_KEY=your_switch_internal_api_key_here
SWITCH_CONSOLE_PATH=/Applications/Switch.app  # Path to local Switch Console if installed

# ------------------------------------------------------------------------------
# 4. CHATGPT CODEX (OPENAI) ADAPTER CONFIGURATION
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_CODEX=gpt-4o
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=4096

# ------------------------------------------------------------------------------
# 5. AGY (ANTIGRAVITY CLI) ADAPTER CONFIGURATION
# ------------------------------------------------------------------------------
AGY_BINARY_PATH=/Users/sidh._./.gemini/antigravity-cli/bin/agentapi
AGY_DEFAULT_WORKSPACE=/Users/sidh._./AgentHive
AGY_EXECUTION_TIMEOUT_SEC=120

# ------------------------------------------------------------------------------
# 6. GOOGLE GEMINI ADAPTER CONFIGURATION
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_PRO=gemini-1.5-pro
GEMINI_MODEL_FLASH=gemini-1.5-flash
GEMINI_TEMPERATURE=0.3

# ------------------------------------------------------------------------------
# 7. HERMES SUPERVISOR CONFIGURATION (Nous Research Hermes Agent)
# ------------------------------------------------------------------------------
HERMES_DAEMON_URL=http://localhost:8686
HERMES_BINARY_PATH=/usr/local/bin/hermes      # Or path to local Hermes binary
HERMES_MEMORY_DB=/Users/sidh._./AgentHive/data/hermes_memory.db
HERMES_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 8. PONY TAIL SKILL & ENGINEERING DISCIPLINE
# ------------------------------------------------------------------------------
PONYTAIL_MODE=full                          # lite | full | ultra | off
PONYTAIL_ENFORCE_STDLIB_ONLY=true
PONYTAIL_MAX_DIFF_LINES=300

# ------------------------------------------------------------------------------
# 9. EPHEMERAL DOCKER EXECUTION SANDBOXES
# ------------------------------------------------------------------------------
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_SANDBOX_IMAGE=python:3.11-alpine
DOCKER_SANDBOX_TIMEOUT_SEC=60
DOCKER_SANDBOX_CPU_QUOTA=1.5
DOCKER_SANDBOX_MEM_LIMIT=1024m
DOCKER_NETWORK_ISOLATION=none               # none (completely offline during code execution)

# ------------------------------------------------------------------------------
# 10. GOVERNANCE, LIMITS & RELIABILITY
# ------------------------------------------------------------------------------
MAX_DISCUSSION_TURNS=10                     # Hard ceiling on agent debate rounds
SESSION_TOKEN_BUDGET=100000                 # Maximum allowed token spend per project debate
SEMANTIC_DRIFT_THRESHOLD=0.92               # Triggers Hermes intervention if cosine similarity exceeds threshold
