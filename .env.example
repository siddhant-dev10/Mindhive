# Copy to .env and fill only values you have configured. Keep .env private.
# Never commit real credentials. Blank secret values fail closed.

ENVIRONMENT=development
LOG_LEVEL=INFO
AGENTHIVE_HOST=127.0.0.1
AGENTHIVE_PORT=8000
DATABASE_URL=sqlite:///./data/agenthive.db
WORKSPACE_ROOT=./workspaces
AGENTHIVE_TASK_EXECUTION_ENABLED=false
AGENTHIVE_TEST_RUNNER_IMAGE=

# Dashboard owner authentication. Set a random value of at least 32 characters
# in the private .env file; do not put it in frontend code or screenshots.
AGENTHIVE_DASHBOARD_API_TOKEN=
AGENTHIVE_DASHBOARD_COOKIE_SECURE=false
AGENTHIVE_DASHBOARD_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# MindHive Discord bot. Fill from Discord Developer Portal.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_LOUNGE_CHANNEL_ID=
DISCORD_OWNER_ID=
DISCORD_WEBHOOK_URL=

# Official Switch is mandatory by default. Set SWITCH_MODE=local only for
# explicitly isolated development/tests. No automatic transport downgrade.
SWITCH_MODE=official
SWITCH_CORE_URL=http://127.0.0.1:8080
SWITCH_WS_URL=ws://127.0.0.1:8082/events
SWITCH_REGISTRATION_TOKEN=
SWITCH_API_KEY=

# Native CLI authentication uses each CLI's own secure local credential store.
# AgentHive does not pass these application secrets into agent subprocesses.
CODEX_BINARY_PATH=
CODEX_EXECUTION_TIMEOUT_SEC=120
AGY_BINARY_PATH=
AGY_DEFAULT_WORKSPACE=./workspaces
AGY_EXECUTION_TIMEOUT_SEC=120

# External runtimes are optional and remain explicit local fallbacks if blank.
GEMINI_API_KEY=
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-2.5-flash
HERMES_DAEMON_URL=http://127.0.0.1:8686
HERMES_DAEMON_TOKEN=
HERMES_BINARY_PATH=
HERMES_MEMORY_DB=./data/hermes_memory.db

# Used by the separate Switch/PostgreSQL Compose deployment template.
# Do not reuse credentials from another stack. Resolve image compatibility,
# volume ownership, and backup/restore before starting that stack.
SWITCH_IMAGE=
SWITCH_DB_NAME=switch
SWITCH_DB_OWNER_USER=switch_owner
SWITCH_DB_OWNER_PASSWORD=
SWITCH_DB_RUNTIME_USER=switch_runtime
SWITCH_DB_RUNTIME_PASSWORD=
SWITCH_AGENT_REGISTRATION_TOKEN=
SWITCH_SECRET_KEYS=
SWITCH_GATEWAY_ADMIN_EMAIL=
SWITCH_GATEWAY_ADMIN_PASSWORD=

PONYTAIL_MODE=full
PONYTAIL_ENFORCE_STDLIB_ONLY=true
PONYTAIL_MAX_DIFF_LINES=300
MAX_DISCUSSION_TURNS=6
SESSION_TOKEN_BUDGET=100000
